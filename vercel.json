{
    "version": 2,
    "buildCommand": null,
    "outputDirectory": ".",
    "routes": [
      {
        "src": "/",
        "dest": "/index.html"
      },
      {
        "src": "/admin/?",
        "dest": "/admin/admin-login.html"
      },
      {
        "src": "/admin/login",
        "dest": "/admin/admin-login.html"
      },
      {
        "src": "/admin/panel",
        "dest": "/admin/admin-panel.html"
      },
      {
        "src": "/(.*)",
        "dest": "/$1"
      }
    ]
  }